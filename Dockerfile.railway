# Imagem de producao para o Railway.
# O Railway so aceita "RUN --mount=type=cache"; o Dockerfile principal usa
# "--mount=type=bind" para a CA corporativa (rede local com proxy) e por isso
# falha na validacao de la. Aqui nao ha proxy: build direto, sem mounts.
# Selecionado pelo railway.json (build.dockerfilePath).

FROM node:20 AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY prisma ./prisma
RUN npm run prisma:generate
COPY . .
RUN npm run build

FROM node:20 AS production
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/package.json ./package.json
# ts-node (seed) precisa do tsconfig; sem ele cai em defaults incompativeis (TS5109)
COPY --from=build /app/tsconfig.json ./tsconfig.json
EXPOSE 3333
# Migrations antes de subir. O seed so roda com o banco vazio (SEED_IF_EMPTY): nunca apaga dados.
# catalog:sync aplica prisma/catalog.ts (upsert por slug/SKU) sem tocar em pedidos e usuarios.
# Falhas no seed ou no sync nao impedem a API de subir (ficam registradas no log).
# seed:admin cria o admin do backoffice (tabela admin_users) a partir de ADMIN_EMAIL (senha so na criacao).
CMD ["sh", "-c", "npm run prisma:deploy && { SEED_IF_EMPTY=true npm run seed || echo 'AVISO: seed falhou'; } && { npm run catalog:sync || echo 'AVISO: catalog:sync falhou'; } && { node dist/prisma/encrypt-documents.js || echo 'AVISO: data:encrypt falhou'; } && { node dist/prisma/seed-admin.js || echo 'AVISO: seed:admin falhou'; } && node dist/src/main"]
