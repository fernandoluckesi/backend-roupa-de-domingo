generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  CUSTOMER
  ADMIN
}

enum Humor {
  ACIDO
  SARCASTICO
  EXISTENCIAL
  MEMES
  PARA_CASAIS
  POLITICO
}

/// Publico-alvo da peca. UNISSEX e o padrao: objetos (canecas, garrafas) e
/// modelagens sem corte especifico servem para qualquer pessoa, e por isso
/// aparecem junto de MASCULINO e de FEMININO na filtragem.
enum Gender {
  UNISSEX
  MASCULINO
  FEMININO
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum OrderStatus {
  PENDING
  PAID
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
}

enum PaymentStatus {
  PENDING
  APPROVED
  IN_PROCESS
  REJECTED
  REFUNDED
  CANCELLED
}

/// Producao e envio feitos pela propria loja (sem parceiro de estamparia)
enum FulfillmentStatus {
  /// Pago, aguardando entrar em producao
  QUEUED
  IN_PRODUCTION
  /// Embalado, etiqueta pronta, aguardando postagem
  PACKED
  /// Postado nos Correios (com codigo de rastreio)
  SHIPPED
  DELIVERED
}

// ---------------------------------------------------------------- usuarios

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  document     String?
  role         Role     @default(CUSTOMER)
  humorLevel   Int      @default(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Aceite dos termos e da politica de privacidade (versao vigente no cadastro)
  termsAcceptedAt    DateTime?
  termsVersion       String?
  privacyVersion     String?
  /// Consentimento de marketing (LGPD art. 7o, I): opcional e revogavel
  marketingOptIn     Boolean   @default(false)
  marketingConsentAt DateTime?
  emailVerifiedAt    DateTime?
  /// Bloqueio progressivo contra forca bruta
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  /// Incrementar revoga todas as sessoes (logout em todos os dispositivos)
  tokenVersion       Int       @default(0)
  /// Conta excluida a pedido do titular: dados pessoais anonimizados
  deletedAt          DateTime?

  addresses   Address[]
  orders      Order[]
  cart        Cart?
  discoveries EasterEggDiscovery[]
  authTokens  AuthToken[]
  consents    ConsentRecord[]
  returns     ReturnRequest[]

  @@map("users")
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  label      String   @default("Casa")
  recipient  String
  zipCode    String
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------- catalogo

model Category {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String?
  emoji       String?
  position    Int     @default(0)

  products Product[]

  @@map("categories")
}

model Product {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  shortDescription String
  description      String
  humor            Humor    @default(ACIDO)
  gender           Gender   @default(UNISSEX)
  basePriceCents   Int
  categoryId       String
  tags             String[] @default([])
  isFeatured       Boolean  @default(false)
  isSecret         Boolean  @default(false)
  isActive         Boolean  @default(true)
  rating           Float    @default(5)
  ratingCount      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]

  @@index([categoryId])
  @@index([humor])
  @@index([gender])
  @@map("products")
}

model ProductVariant {
  id                     String  @id @default(uuid())
  productId              String
  sku                    String  @unique
  size                   String?
  color                  String?
  model                  String?
  priceCents             Int
  weightGrams            Int     @default(300)
  isAvailable            Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  alt       String
  /// Cor da variante que aparece na foto; null = vale para todas
  color     String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ---------------------------------------------------------------- carrinho

model Cart {
  id        String   @id @default(uuid())
  userId    String?  @unique
  sessionId String?  @unique
  couponId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon?    @relation(fields: [couponId], references: [id])
  items  CartItem[]

  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String
  variantId  String
  quantity   Int      @default(1)
  customText String?
  createdAt  DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// ---------------------------------------------------------------- cupons

model Coupon {
  id               String     @id @default(uuid())
  code             String     @unique
  description      String
  type             CouponType @default(PERCENT)
  value            Int        @default(0)
  minSubtotalCents Int        @default(0)
  maxUses          Int?
  usedCount        Int        @default(0)
  isSecret         Boolean    @default(false)
  isActive         Boolean    @default(true)
  expiresAt        DateTime?
  createdAt        DateTime   @default(now())

  carts      Cart[]
  orders     Order[]
  easterEggs EasterEgg[]

  @@map("coupons")
}

// ---------------------------------------------------------------- pedidos

model Order {
  id     String      @id @default(uuid())
  number String      @unique
  userId String?
  status OrderStatus @default(PENDING)

  customerName     String
  customerEmail    String
  customerPhone    String?
  customerDocument String?

  shippingRecipient  String
  shippingZipCode    String
  shippingStreet     String
  shippingNumber     String
  shippingComplement String?
  shippingDistrict   String
  shippingCity       String
  shippingState      String

  subtotalCents Int
  discountCents Int @default(0)
  shippingCents Int @default(0)
  totalCents    Int

  couponId       String?
  shippingMethod String  @default("economico")
  estimatedDays  Int     @default(10)
  trackingCode   String?
  notes          String?
  timeline       Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User?           @relation(fields: [userId], references: [id])
  coupon      Coupon?         @relation(fields: [couponId], references: [id])
  items       OrderItem[]
  payment     Payment?
  fulfillment Fulfillment?
  invoice     Invoice?
  returns     ReturnRequest[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  variantId      String?
  productName    String
  variantLabel   String
  sku            String
  unitPriceCents Int
  quantity       Int
  totalCents     Int
  imageUrl       String?
  customText     String?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  provider          String        @default("mercadopago")
  preferenceId      String?
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  method            String?
  installments      Int?
  amountCents       Int
  initPoint         String?
  rawPayload        Json?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

/// Producao, embalagem e postagem do pedido (operacao propria, envio pelos Correios)
model Fulfillment {
  id                  String            @id @default(uuid())
  orderId             String            @unique
  status              FulfillmentStatus @default(QUEUED)
  carrier             String            @default("Correios")
  /// PAC | SEDEX
  serviceCode         String?
  trackingCode        String?
  trackingUrl         String?
  packageWeightGrams  Int?
  packageLengthCm     Int?
  packageWidthCm      Int?
  packageHeightCm     Int?
  /// Anotacao interna da equipe (o cliente nao ve)
  internalNotes       String?
  labelPrintedAt      DateTime?
  productionStartedAt DateTime?
  packedAt            DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("fulfillments")
}

// ---------------------------------------------------------------- easter eggs

model EasterEgg {
  id             String  @id @default(uuid())
  code           String  @unique
  title          String
  hint           String
  message        String
  trigger        String
  points         Int     @default(10)
  rewardCouponId String?
  isActive       Boolean @default(true)

  rewardCoupon Coupon?              @relation(fields: [rewardCouponId], references: [id])
  discoveries  EasterEggDiscovery[]

  @@map("easter_eggs")
}

model EasterEggDiscovery {
  id           String   @id @default(uuid())
  easterEggId  String
  userId       String?
  sessionId    String?
  discoveredAt DateTime @default(now())

  easterEgg EasterEgg @relation(fields: [easterEggId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([easterEggId, userId])
  @@unique([easterEggId, sessionId])
  @@map("easter_egg_discoveries")
}

// ---------------------------------------------------------------- conformidade (LGPD, CDC, seguranca)

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PASSWORD_CHANGE
  EMAIL_CHANGE
  /// Legado (login de admin antes da tabela admin_users); sem uso
  LOGIN_CODE
}

/// Tokens e codigos de 6 digitos de uso unico; so o hash fica no banco
model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  /// Tentativas erradas do codigo; ao chegar no limite o codigo e invalidado
  attempts  Int           @default(0)
  /// Troca de e-mail: endereco novo que recebe o codigo e passa a valer depois da confirmacao
  newEmail  String?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

/// Prova do consentimento (LGPD art. 8o, par. 2o): quem, o que, qual versao, quando
model ConsentRecord {
  id        String   @id @default(uuid())
  userId    String?
  sessionId String?
  /// cookies | terms | privacy | marketing
  kind      String
  version   String
  granted   Boolean
  details   Json?
  /// IP com hash (minimizacao): suficiente para auditoria sem guardar o IP cru
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@map("consent_records")
}

enum ContactStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// SAC (Decreto 7.962/2013, art. 4o): protocolo e prazo de resposta de 5 dias uteis
model ContactMessage {
  id          String        @id @default(uuid())
  protocol    String        @unique
  userId      String?
  name        String
  email       String
  subject     String
  orderNumber String?
  message     String
  status      ContactStatus @default(OPEN)
  respondBy   DateTime
  answeredAt  DateTime?
  createdAt   DateTime      @default(now())

  @@index([status])
  @@map("contact_messages")
}

enum ReturnType {
  /// Direito de arrependimento (CDC art. 49): 7 dias do recebimento
  REGRET
  /// Vicio do produto (CDC art. 26): 90 dias para produto duravel
  DEFECT
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  REFUNDED
  EXCHANGED
}

model ReturnRequest {
  id          String       @id @default(uuid())
  protocol    String       @unique
  orderId     String
  userId      String?
  type        ReturnType
  status      ReturnStatus @default(REQUESTED)
  reason      String
  /// [{ orderItemId, quantity }]
  items       Json
  /// Codigo de postagem reversa (Correios), gratuito para o cliente
  reverseCode String?
  refundCents Int?
  resolution  String?
  timeline    Json         @default("[]")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([userId])
  @@map("return_requests")
}

// ---------------------------------------------------------------- equipe (backoffice)

/// Usuarios do backoffice. Separados dos clientes (users): login, sessao e senha proprios.
model AdminUser {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String
  passwordHash     String
  isActive         Boolean   @default(true)
  /// Bloqueio progressivo contra forca bruta
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  /// Incrementar revoga todas as sessoes do admin
  tokenVersion     Int       @default(0)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  loginCodes AdminLoginCode[]

  @@map("admin_users")
}

/// Codigo de 6 digitos da segunda etapa do login do backoffice (so o hash fica no banco)
model AdminLoginCode {
  id          String    @id @default(uuid())
  adminUserId String
  codeHash    String
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_login_codes")
}

enum AuditCategory {
  AUTH
  ACCOUNT
  PRIVACY
  ORDER
  PAYMENT
  FULFILLMENT
  RETURN
  INVOICE
  CONTACT
  ADMIN
  SYSTEM
}

enum AuditActorType {
  CUSTOMER
  ADMIN
  ANONYMOUS
  /// Rotinas internas (job, sincronizacao)
  SYSTEM
  /// Webhook de terceiro (Mercado Pago, grafica)
  PROVIDER
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

/// Trilha de auditoria: seguranca (login, senha, e-mail), conta, privacidade,
/// pedidos, pagamentos, entrega, trocas, notas e toda acao administrativa.
/// So insercao (trigger bloqueia UPDATE); limpeza por retencao via DELETE.
model AuditLog {
  id         String         @id @default(uuid())
  category   AuditCategory
  /// Evento no formato dominio.acao (ex.: auth.login.failed, order.created)
  action     String
  outcome    AuditOutcome   @default(SUCCESS)
  actorType  AuditActorType
  actorId    String?
  /// So para a equipe (ADMIN); clientes ficam identificados apenas pelo id
  actorEmail String?
  targetType String?
  targetId   String?
  method     String?
  /// Rota sem query string (query pode carregar dado pessoal)
  path       String?
  statusCode Int?
  /// Dados do evento / corpo da requisicao, com dados pessoais mascarados
  payload    Json?
  ipHash     String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime       @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@index([category, createdAt])
  @@index([targetType, targetId])
  @@index([action])
  @@map("audit_logs")
}

enum InvoiceStatus {
  PENDING
  ISSUED
  ERROR
  CANCELLED
}

/// NF-e do pedido (guarda fiscal de 5 anos)
model Invoice {
  id             String        @id @default(uuid())
  orderId        String        @unique
  provider       String        @default("mock")
  status         InvoiceStatus @default(PENDING)
  number         String?
  series         String?
  accessKey      String?
  pdfUrl         String?
  xmlUrl         String?
  /// Tributos aproximados (Lei 12.741/2012), em centavos
  approxTaxCents Int?
  lastError      String?
  issuedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}
