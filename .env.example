# ---------- App ----------
NODE_ENV=development
PORT=3333
API_PREFIX=api
CORS_ORIGIN=http://localhost:5273
FRONTEND_URL=http://localhost:5273

# ---------- Banco ----------
# Dentro do docker compose o host e "postgres"; rodando fora, use "localhost"
DATABASE_URL=postgresql://domingo:domingo@postgres:5432/roupadedomingo?schema=public

# ---------- Auth ----------
JWT_SECRET=troque-este-segredo-no-ambiente-real
JWT_EXPIRES_IN=7d

# ---------- Pagamento ----------
# mock = simula o checkout localmente | mercadopago = integracao real
PAYMENT_DRIVER=mock
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_USE_SANDBOX=true
# URL publica (ngrok) para o Mercado Pago alcancar o webhook em desenvolvimento
MP_NOTIFICATION_URL=
# Assinatura secreta do webhook (painel MP > Configuracao de webhooks). Valida o header x-signature
MP_WEBHOOK_SECRET=

# ---------- Dropshipping (estamparia) ----------
# mock = simulado | printful = Printful real (ver docs/PRINTFUL-API.md) | http = generico
PRINT_PROVIDER=mock
PRINT_API_URL=
PRINT_API_KEY=
PRINT_WEBHOOK_SECRET=segredo-estamparia
# multiplicador de velocidade da simulacao de producao (1 = normal)
PRINT_MOCK_SPEED=1
# Printful: token privado em developers.printful.com/tokens vai em PRINT_API_KEY
PRINTFUL_STORE_ID=
# false = pedido fica em rascunho na Printful (nao cobra). true = confirma e cobra
PRINTFUL_CONFIRM_ORDERS=false

# ---------- Regras de negocio ----------
FREE_SHIPPING_THRESHOLD_CENTS=24900

# ---------- Seed em producao (ver docs/RAILWAY.md) ----------
# SEED_IF_EMPTY=true   -> so carrega se o banco estiver vazio (usado no start do Railway)
# SEED_ALLOW_RESET=true -> permite o seed apagar tudo com NODE_ENV=production
# SEED_ADMIN_EMAIL= / SEED_ADMIN_PASSWORD= -> cria o admin na carga inicial de producao

# ---------------------------------------------------------------- seguranca e LGPD
# Chave AES-256 para cifrar CPF e segredo 2FA em repouso: openssl rand -base64 32
# Sem ela, usa uma chave derivada do JWT_SECRET (funciona, mas trocar o JWT_SECRET quebraria a leitura).
# Ao configurar depois, rode: npm run data:encrypt -- --rotate
DATA_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=rd_session
# true em producao (HTTPS). Padrao: true quando NODE_ENV=production
COOKIE_SECURE=
# Swagger em /api/docs. Padrao: ligado fora de producao, desligado em producao
SWAGGER_ENABLED=
# Rotas de admin exigem 2FA (POST /api/auth/2fa/setup + /enable)
ADMIN_2FA_REQUIRED=true
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15

# ---------------------------------------------------------------- e-mail transacional
# log = so escreve no console (dev); smtp = envia de verdade
MAIL_DRIVER=log
MAIL_FROM="Roupa de Domingo <nao-responda@roupadedomingo.com.br>"
MAIL_SAC_INBOX=sac@roupadedomingo.com.br
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------- nota fiscal
# Percentual aproximado de tributos (tabela IBPT, Lei 12.741/2012) informado pela contabilidade
INVOICE_APPROX_TAX_PERCENT=

# Proxies confiaveis na frente da API (Railway: borda + nginx do frontend = 2)
TRUST_PROXY_HOPS=2
